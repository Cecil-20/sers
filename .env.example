# Copy to .env and fill in. Never commit .env.

# --- Django ---
SECRET_KEY=generate-a-long-random-string-of-50-or-more-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/

# --- Production only (used when DEBUG=False) ---
# Backend host(s), no scheme: your-api.onrender.com
# ALLOWED_HOSTS=your-api.onrender.com
# Frontend and backend origins, with scheme, comma separated
# CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# NUM_PROXIES=1
# SECURE_HSTS_SECONDS=3600

# --- Frontend address (used in emailed links) ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis (WebSocket channel layer) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Cloudinary (incident photos, private delivery) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=SERIMS <alerts@your-verified-domain.example>

# --- AI providers ---
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# Set to require when the database is on Supabase
DB_SSLMODE=prefer
